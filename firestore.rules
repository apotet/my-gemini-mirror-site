rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isLessonId(value) {
      return value is string && value.matches('^[a-z0-9][a-z0-9-]{0,95}$');
    }

    match /netopsMirrorUsers/{uid}/favorites/{lessonId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isLessonId(lessonId)
        && request.resource.data.keys().hasOnly(['active'])
        && request.resource.data.active is bool;
      // Retain the removal marker so an old device cannot reimport this favorite.
      allow delete: if false;
    }

    match /netopsMirrorUsers/{uid}/settings/resume {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lessonId'])
        && isLessonId(request.resource.data.lessonId);
    }
  }
}
